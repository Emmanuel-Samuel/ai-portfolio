# LLM Configuration for AI Twin (Optional API configs)
# Used specifically in src/app/api/chat/route.ts for the AI twin integration.

# Which provider to use: "anthropic" (default), "openrouter", or "gemini"
# LLM_PROVIDER="anthropic"

# --- Anthropic (default provider) ---
# Anthropic API key. Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# --- OpenRouter (set LLM_PROVIDER="openrouter" to use) ---
# OpenRouter API key. Get one from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# --- Google Gemini (set LLM_PROVIDER="gemini" to use) ---
# Gemini API key, via the OpenAI-compatible endpoint. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Override the upstream endpoint URL (defaults per-provider; only needed for proxies)
# LLM_BASE_URL="https://api.anthropic.com/v1/messages"

# Override default model (defaults per-provider: claude-sonnet-5 / google/gemini-2.5-flash / gemini-2.5-flash)
# AI_MODEL="claude-sonnet-5"

# Resend contact form delivery
# Verify your sending domain in Resend first, then use an address on that domain.
RESEND_API_KEY="re_your_resend_api_key"
CONTACT_EMAIL_FROM="Portfolio Contact <hello@example.com>"
CONTACT_EMAIL_TO="hello@example.com,team@example.com"
