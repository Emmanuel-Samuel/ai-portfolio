# LLM Configuration for AI Twin (Optional API configs)
# Used specifically in src/app/api/chat/route.ts for the AI twin integration.

# Anthropic API key. Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# The base URL of the Anthropic Messages endpoint (override only for proxies)
LLM_BASE_URL="https://api.anthropic.com/v1/messages"

# Override default model
# AI_MODEL="claude-sonnet-5"

# Resend contact form delivery
# Verify your sending domain in Resend first, then use an address on that domain.
RESEND_API_KEY="re_your_resend_api_key"
CONTACT_EMAIL_FROM="Portfolio Contact <hello@example.com>"
CONTACT_EMAIL_TO="hello@example.com,team@example.com"
